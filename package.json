{
  "name": "wallpaper-plugin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 美化插件：预设/主题管理 + 壁纸 2.0（链接/渐变/轮换）+ 27 旋钮层 + 中英双语",
  "author": "Yunicon <ayase112594@gmail.com>",
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:client": "node scripts/build.mjs --check:client",
    "selfcheck": "node scripts/selfcheck.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "gen:builtin-assets": "node scripts/gen-builtin-assets.mjs",
    "test": "node scripts/build.mjs && node scripts/run-unit.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "license": "MIT"
}
